{
  "name": "preureal",
  "version": "0.7.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "postinstall": "prisma generate",
    "build": "node scripts/check_repo.mjs && prisma generate && prisma migrate deploy && next build",
    "build:selfhost": "node scripts/check_repo.mjs && prisma generate && next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "NODE_ENV=production node .next/standalone/server.js",
    "lint": "eslint .",
    "db:push": "prisma db push --accept-data-loss",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.14",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "pdf-lib": "^1.17.1",
    "prisma": "^6.11.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^23.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  }
}
