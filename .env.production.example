# ============================================================================
# PreuReal.cat — plantilla de variables de entorno de PRODUCCIÓN
#
#   cp .env.production.example .env && nano .env
#
# Genera los secretos con:  openssl rand -hex 32
# NUNCA subas el .env real a git (ya está en .gitignore).
# ============================================================================

# --- Base de datos PostgreSQL (OBLIGATORIA) ---------------------------------
# Supabase (proyecto ya creado): Settings → Database → Connection string → URI.
# v23: usa el SESSION POOLER puerto 5432 (aws-0-<regio>.pooler.supabase.com:5432).
# El puerto 6543 (Transaction Pooler) CUELGA `prisma migrate deploy` en build.
# Ejemplo:
# DATABASE_URL=postgresql://postgres.tkbjifmflpxqszaozqlw:[DB-PASSWORD]@aws-0-<regio>.pooler.supabase.com:5432/postgres
# NOTA: las claves anon / service_role JWT de Supabase NO valen para Prisma —
# esta app se conecta directo a PostgreSQL. La service_role es un SECRETO:
# nunca a git ni a código compartido.
# Neon (alternativa, plan gratuito): "pooled connection string" (contiene -pooler).
# Ejemplo:
# DATABASE_URL=postgresql://usuari:clau@ep-xxxx-pooler.eu-central-1.aws.neon.tech/preureal?sslmode=require
DATABASE_URL=

# --- Obligatorias -----------------------------------------------------------

# URL pública del sitio (SIN barra final).
# v20: dominio canónico EN PRODUCCIÓN = https://www.preureal.com (el DNS de
# preureal.cat no está configurado: NXDOMAIN — no usar hasta que apunte a Vercel).
NEXT_PUBLIC_SITE_URL=https://www.preureal.com

# Política de incrustación en iframes (CSP frame-ancestors).
# Por defecto en producción: 'self' (anti-clickjacking).
# Solo cámbiala si quieres incrustar el mapa como widget en otro dominio:
# FRAME_ANCESTORS="'self' https://portal-exemple.cat"
FRAME_ANCESTORS=

# Secreto de firma de sesiones JWT — ¡GENÉRALO! (openssl rand -hex 32)
# En producción, si falta, la app NO ARRANCA (protección contra secretos públicos).
AUTH_SECRET=

# Contraseña del administrador (el seed la crea: admin@preureal.cat).
# ¡CÁMBIALA respecto al valor por defecto de desarrollo!
ADMIN_PASSWORD=

# --- Stripe (DEMO hasta que autorices la cuenta real) -----------------------
# Mientras STRIPE_SECRET_KEY no exista y DEMO_CHECKOUT=true, el checkout usa
# /api/stripe/demo y NO cobra (suscripciones marcadas como demo).
# ⚠️ NUNCA dejes DEMO_CHECKOUT=true en producción real: permite activar
# suscripciones de prueba SIN cobro (marcadas demo:true y claramente separadas).
# Al activar la cuenta real:
#  1) crea 2 precios recurrentes (Premium 7,99 €/mes, Pro 19,99 €/mes)
#  2) pega aquí sus price_xxx (nombres canónicos v22; los antiguos
#     STRIPE_PRICE_PREMIUM / STRIPE_PRICE_PRO siguen funcionando como fallback)
#  3) webhook → https://www.preureal.com/api/stripe/webhook (eventos:
#     checkout.session.completed, customer.subscription.created/updated/deleted,
#     invoice.paid, invoice.payment_failed)
#  4) activa el Portal de cliente en Stripe (Settings → Billing → Customer portal)
#  5) DEMO_CHECKOUT=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_PRO_AGENTS_PRICE_ID=
DEMO_CHECKOUT=true

# --- Email (opcional; sin clave → proveedor "sandbox", solo log en BD) ------
# Recomendado: Resend (capa gratuita 3.000 mails/mes) → verifica el dominio
RESEND_API_KEY=
MAIL_FROM="Preureal <hola@preureal.com>"
# ⚠️ El dominio del remitente debe estar VERIFICADO en Resend (Domains →
# añadir preureal.com → pegar los registros DKIM/SPF en el DNS de Vercel).
# Sin dominio verificado, Resend solo permite enviar a la dirección de tu
# propia cuenta (con onboarding@resend.dev rechaza el resto con HTTP 403).

# --- Mantenimiento del sistema de correo (recomendado) ----------------------
# Protege /api/cron/emails (limpieza + reintentos; Vercel Cron lo llama 1 vez
# al día con Authorization: Bearer $CRON_SECRET). Genera: openssl rand -hex 32
CRON_SECRET=
# Días de retención del EmailLog (el cron borra lo más viejo; 90 por defecto)
# EMAILLOG_RETENTION_DAYS=90

# --- Google OAuth (opcional; sin credenciales el botón "Continua amb Google"
#     se oculta automáticamente) ------------------------------------------------
# Redirect URI a autorizar en Google Cloud Console:
#   https://www.preureal.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
