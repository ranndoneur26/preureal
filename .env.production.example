# ============================================================================
# PreuReal.cat — plantilla de variables de entorno de PRODUCCIÓN
#
#   cp .env.production.example .env && nano .env
#
# Genera los secretos con:  openssl rand -hex 32
# NUNCA subas el .env real a git (ya está en .gitignore).
# ============================================================================

# --- Obligatorias -----------------------------------------------------------

# URL pública del sitio (coincide con DOMAIN de Caddy, SIN barra final)
NEXT_PUBLIC_SITE_URL=https://preureal.cat

# Secreto de firma de sesiones JWT — ¡GENÉRALO! (openssl rand -hex 32)
AUTH_SECRET=

# Contraseña del administrador (el seed la crea: admin@preureal.cat).
# ¡CÁMBIALA respecto al valor por defecto de desarrollo!
ADMIN_PASSWORD=

# --- Base de datos ----------------------------------------------------------
# En Docker NO se usa: docker-compose fuerza DATABASE_URL=file:/data/custom.db
# (volumen ./dbdata en el host). Solo relevante fuera de Docker.
# DATABASE_URL=file:/home/deploy/preureal/dbdata/custom.db

# --- Stripe (DEMO hasta que autorices la cuenta real) -----------------------
# Mientras DEMO_CHECKOUT=true, el checkout usa /api/stripe/demo y NO cobra.
# Al activar la cuenta real:
#  1) crea 2 precios recurrentes (Premium 7,99 €/mes, Pro 19,99 €/mes)
#  2) pega aquí sus price_xxx
#  3) webhook → https://preureal.cat/api/stripe/webhook (evento checkout.session.completed)
#  4) DEMO_CHECKOUT=false y reinicia: docker compose up -d
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_PRO=
DEMO_CHECKOUT=true

# --- Email (opcional; sin clave → proveedor "sandbox", solo log en BD) ------
# Recomendado: Resend (capa gratuita 3.000 mails/mes) → verifica el dominio preureal.cat
RESEND_API_KEY=
MAIL_FROM="PreuReal.cat <hola@preureal.cat>"

# --- Dominio para Caddy -----------------------------------------------------
# Domain que servirá el reverse proxy (certificado automático).
# Para probar por IP antes del DNS: DOMAIN=:80 (y comenta el bloque www en
# deploy/Caddyfile.prod).
DOMAIN=preureal.cat
