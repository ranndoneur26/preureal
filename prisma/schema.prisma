// Preureal — Esquema de base de datos (PostgreSQL)
// Datos reales: municipios (Idescat/Gencat), lloguer fiances Incasòl (Gencat),
// àrees tensades (Resolucions TER/3739/2026 + TER/3740/2026), edificis ICGC (RTT).
//
// Backend: PostgreSQL gestionat (Neon/Supabase) — compatible Vercel serverless.
// Migració versionada: prisma/migrations/ (aplicar amb `npx prisma migrate deploy`).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  passwordHash       String
  name               String?
  locale             String              @default("ca")
  role               String              @default("USER") // USER | ADMIN
  plan               String              @default("FREE") // FREE | PREMIUM | PRO
  active             Boolean             @default(true) // desactivació per admin (RGPD/bans)
  emailVerifiedAt    DateTime? // verificació de correu (Fase 6)
  tokenVersion       Int                 @default(0) // +1 invalida totes les sessions actives
  lastLoginAt        DateTime?
  // v37 — 2FA TOTP (RFC 6238): el secret es guarda CIFRAT (AES-256-GCM amb
  // clau derivada d'AUTH_SECRET); recovery codes com a JSON de hashes bcrypt.
  totpSecret         String?
  totpEnabled        Boolean             @default(false)
  totpRecoveryCodes  String?
  // v24 — resum mensual per correu dels municipis/edificis preferits (opt-in
  // explícit a "Panell → Preferits": mai actiu per defecte, RGPD-friendly)
  alertsEnabled      Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  subscriptions      Subscription[]
  searchLogs         SearchLog[]
  priceReports       PriceReport[]
  passwordTokens     PasswordToken[]
  emailTokens        EmailToken[]
  favorites          Favorite[]
  savedComparisons   SavedComparison[]
  subscriptionUsages SubscriptionUsage[]
  passkeys           PasskeyCredential[]

  @@index([role])
  @@index([plan])
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id])
  stripeCustomerId     String?
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  plan                 String // PREMIUM | PRO
  status               String // active | trialing | past_due | canceled | expired | superseded | incomplete | incomplete_expired
  currentPeriodStart   DateTime? // v22: inici del període de facturació vigent
  currentPeriodEnd     DateTime?
  billingInterval      String? // v22: month | year (recurrent del preu de Stripe)
  cancelAtPeriodEnd    Boolean   @default(false) // v22: cancelació programada a final de període
  cancelReason         String? // v37: motiu declarat al flux de retenció (analytics)
  demo                 Boolean   @default(false) // suscripción creada en modo prueba (sin Stripe)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

// v22 (Fase 1 subscripcions): comptadors d'ús agregats per usuari, tipus i mes
// ("YYYY-MM" UTC). Font: accions reals registrades al servidor (lookup, exports,
// PDF...). Mai s'escriu des del client — només les rutes de l'API (equivalent
// funcional de les policies RLS en una arquitectura on l'ÚNIC client de
// Postgres és el backend via Prisma).
model SubscriptionUsage {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  usageType  String // DETAIL_QUERY | EXPORT_CSV | PDF_REPORT | ...
  usageMonth String // "2026-11"
  usageCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, usageType, usageMonth])
  @@index([userId, usageMonth])
}

model PasswordToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Tokens de verificació de correu (Fase 6)
model EmailToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Municipios de Cataluña (código INE de 5 dígitos) con datos reales de lloguer
model Municipality {
  code              String    @id // "080193" (6 dígitos formato Gencat/ICGC)
  ineCode           String? // "08019" (5 dígitos)
  name              String
  comarca           String?
  province          String?
  lat               Float
  lng               Float
  rentLatest        Float? // €/mes — fiances Incasòl, último período disponible
  rentPeriod        String? // "2025" o "2026 I trim."
  rentPrevYear      Float? // año anterior para tendencia
  rentPrevPeriod    String?
  rentHistory       String? // JSON {"2005": 550.2, ...}
  contractsLatest   Int? // nº contratos con fianza depositada (muestra)
  // Referència de comarca per als municipis sense dada oficial municipal
  // (mostra petita: Incasòl no publica la renda mitjana). MITJANA PONDERADA
  // pel nº de contractes dels municipis de la comarca EL MATEIX ANY — mai
  // dada municipal inventada; la UI la mostra sempre marcada com estimació.
  comarcaRefLatest  Float? // €/mes — ref. comarca vigent
  comarcaRefPeriod  String? // "2025"
  comarcaRefHistory String? // JSON {"2005": ..., } sèrie de ref. de comarca
  rentSource        String? // "INCASOL" | "COMARCA_REF" | "SENSE_DADA"
  isTense           Boolean   @default(false)
  tenseList         String? // "A" (TER/3739/2026) | "C" (TER/3740/2026)
  boundary          String? // GeoJSON del límite municipal (cache ICGC)
  boundaryFetchedAt DateTime?
  slug              String? @unique // v37: slug públic per a /lloguer/[slug] (SEO)
  updatedAt         DateTime  @updatedAt

  @@index([name])
  @@index([isTense])
}

// Edificios reales (ICGC RTT construccions) cacheados por la app
model Building {
  id               String   @id @default(cuid())
  externalId       String   @unique // id RTT o refcat catastral
  source           String   @default("ICGC_RTT")
  municipalityCode String?
  tipus            String? // edi (edifici) | ill (illa) | ...
  estat            String?
  altura           Int?
  nom              String?
  polygonJson      String // [[ [lng,lat], ... ]]
  centroidLat      Float
  centroidLng      Float
  refcat           String? // referencia catastral (si se conoce)
  yearBuilt        Int? // año de construcción (Catastro, cuando esté disponible)
  yearSource       String? // "CADASTRE_DNP" | "IMPORT"
  // Dades de lloguer a nivell edifici/illa (importació Incasòl — Fase 9.1)
  avgRentEurMonth  Float? // preu mitjà real de l'illa/edifici (font importada)
  sampleSize       Int? // mostres (contractes) de les quals surt la mitjana
  cachedAt         DateTime @default(now())

  @@index([municipalityCode])
  @@index([centroidLat, centroidLng])
}

// Registro de consultas (cuota + analítica + historial d'usuari)
model SearchLog {
  id               String   @id @default(cuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id])
  buildingId       String?
  municipalityCode String?
  ipHash           String?
  kind             String   @default("DETAIL") // DETAIL | TEASER
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
  @@index([municipalityCode])
}

// Eventos de conversión (embudo de ventas)
model Event {
  id        String   @id @default(cuid())
  type      String // SIGNUP | LOGIN | MAP_QUERY | PAYWALL_VIEW | CHECKOUT_START | CHECKOUT_DEMO | SUBSCRIBE_SUCCESS | PRICE_REPORT | EXPORT | PASSWORD_RESET
  userId    String?
  meta      String?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
}

// Informes de precio enviados por usuarios (crowdsourcing, amb moderació — Fase 10)
model PriceReport {
  id               String    @id @default(cuid())
  userId           String?
  user             User?     @relation(fields: [userId], references: [id])
  municipalityCode String?
  buildingId       String?
  offerEurMonth    Float?
  offerEurM2       Float?
  surfaceM2        Float?
  rooms            Int?
  contractType     String? // HABITATGE | HABITATGE_COMPARTIT | LOCAL | ALTRE
  reportedAt       DateTime? // data de l'operació declarada per l'usuari
  note             String?
  status           String    @default("PENDING") // PENDING | ACCEPTED | REJECTED
  reviewedAt       DateTime?
  reviewNote       String?
  createdAt        DateTime  @default(now())

  @@index([status])
  @@index([municipalityCode, createdAt])
}

// Correos automáticos (log del modo sandbox o resultado de Resend).
// v19 (auditoría de correo):
//  - `body` guarda el HTML REDACTADO: los tokens de verificación/restablecimiento
//    se sustituyen por *** antes de persistir (nunca en claro en la BD).
//  - Telemetría de entrega: type, userId, providerMessageId, attempts, sentAt.
//  - Outbox duradero: status "pending" + nextRetryAt → /api/cron/emails reintenta
//    con backoff los tipos no sensibles (WELCOME/RECEIPT/GENERIC).
//  - idempotencyKey: un correo lógico = un envío (recibos Stripe, re-entregas).
model EmailLog {
  id                String    @id @default(cuid())
  to                String
  subject           String
  body              String
  provider          String    @default("sandbox") // sandbox | resend
  status            String    @default("logged") // logged | pending | sent | error
  error             String?
  type              String    @default("GENERIC") // WELCOME | VERIFY | RESET | RECEIPT | GENERIC
  userId            String?
  providerMessageId String? // id que devuelve Resend al aceptar el envío
  attempts          Int       @default(0)
  sentAt            DateTime? // cuando Resend ACEPTÓ el correo (≠ entrega en bandeja)
  nextRetryAt       DateTime? // outbox: cuándo el cron debe reintentarlo
  idempotencyKey    String?   @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status, nextRetryAt])
  @@index([createdAt])
  @@index([userId])
}

// --- Taules noves (BLOC A/B/C de l'encàrrec) --------------------------------

// Rate limiting COMPARTIT entre instàncies (serverless) — V3 de l'auditoria
model RateLimit {
  key       String   @id // "login:1.2.3.4" | "lookup:userId" ...
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())

  @@index([resetAt])
}

// Idempotència de webhooks Stripe — V9 de l'auditoria
model StripeEvent {
  eventId     String   @id // event.id de Stripe
  type        String
  processedAt DateTime @default(now())
}

// Historial d'auditoria d'accions administratives — Fase 12
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String? // usuari admin que fa l'acció
  action    String // USER_PLAN_CHANGE | USER_ROLE_CHANGE | USER_DEACTIVATE | IMPORT_RUN | REPORT_MODERATE | ...
  target    String? // identificador de l'objecte (userId, codi municipi...)
  meta      String? // JSON amb detalls (abans→després)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

// Execucions d'importació de dades — Fase 9.2
model ImportRun {
  id        String   @id @default(cuid())
  source    String // INCASOL_EDIFICIS | INCASOL_MUNICIPIS | ...
  status    String // OK | PARTIAL | ERROR
  rowsTotal Int      @default(0)
  created   Int      @default(0)
  updated   Int      @default(0)
  skipped   Int      @default(0)
  error     String?
  createdBy String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Límits i preus dels plans — configurables des de l'admin (Fase 5)
model PlanSetting {
  plan       String   @id // FREE | PREMIUM | PRO
  quotaMonth Int // consultes detallades/mes (-1 = il·limitades)
  priceEur   Float
  features   String? // JSON {exportCsv: bool, historial: bool, ...}
  updatedAt  DateTime @updatedAt
}

// Edificis i municipis preferits de l'usuari — Fase 9
model Favorite {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  entityKey        String // "BUILDING:<id>" | "MUNI:<code>"
  buildingId       String?
  municipalityCode String?
  label            String? // nom per mostrar (nom municipi / refcat)
  // v37 — alertes de preu: alertPct null = sense alerta; en canviar el preu
  // vigent un >= alertPct% (o el municipi passa a área tensada) el cron
  // /api/cron/emails envia un avís (idempotent via PriceAlertLog).
  alertPct         Float?
  lastNotifiedValue Float?
  tenseNoticed     Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@unique([userId, entityKey])
  @@index([userId])
}

// v37 — log d'idempotència de les alertes de preu: 1 avís per usuari/entitat/
// tipus/període (mai dobles notificacions per la mateixa publicació oficial).
model PriceAlertLog {
  id        String   @id @default(cuid())
  userId    String
  entityKey String // "BUILDING:<id>" | "MUNI:<code>"
  kind      String // PRICE | TENSE
  period    String // període oficial de la dada que va disparar l'avís
  prevValue Float?
  newValue  Float?
  pctChange Float?
  notifiedAt DateTime @default(now())

  @@unique([userId, entityKey, kind, period])
  @@index([userId])
}

// v37.1 — Passkeys (WebAuthn): credencials d'accés sense contrasenya.
// `id` és el credential ID base64url (PK). publicKey base64url (COSE).
// counter: anti-clonatge (s'incrementa a cada ús i es compara amb la BD).
model PasskeyCredential {
  id          String   @id
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  publicKey   String
  counter     Int      @default(0)
  transports  String? // JSON ["internal","hybrid"...]
  deviceType  String? // singleDevice | multiDevice
  backedUp    Boolean  @default(false)
  label       String? // nom amigable (navegador/OS)
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime?

  @@index([userId])
}

// Comparacions desades — Fase 8
model SavedComparison {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  entities  String // JSON [{type:"MUNI"|"BUILDING", code:"..."}]
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Fase 2 — Fonts oficials (INE): catàleg i observacions estadístiques ────
// Migració ADDITIVA: cap taula existent no es toca. Els indicadors nous
// (IPVA, Atlas de renda, més endavant SERPAVI i ajudes) viuen aquí, separats
// de les dades de negoci (fiances Incasòl) per no barrejar unitats ni
// metodologies: les fiances continuen sent la mesura del mercat real
// registrat, i aquestes taules aporten el marc de referència oficial.

// ─── Fase 4 — Ajudes al lloguer (contingut editorial, enquestable) ──────────
// Catàleg editorial d'ajudes i convocatories (nivell estatal i Generalitat),
// citat per la guia #/guia. Cada fila porta font oficial, enllaç, estat i
// data de revisió (governança: alta/actualització trimestral amb data i
// font; les finalitzades es conserven, mai s'esborren). Migració ADITIVA:
// cap taula existent no es toca.
model RentalAid {
  id             String   @id @default(cuid())
  code           String   @unique // "BONO_ALQUILER_JOVEN" | "AJUTS_LLOGUER_GENCAT" | ...
  title          String // títol (ca)
  titleEs        String? // títol (es)
  description    String // resum de requisits i condicions (ca)
  descriptionEs  String? // resum (es)
  scope          String // ESTATAL | CCAA
  scopeCode      String? // null = tot l'Estat; "09" = Catalunya
  amount         String? // "250 €/mes, màx. 24 mesos" (text lliure de la font)
  audience       String? // a qui va dirigit (resum, ca)
  audienceEs     String?
  status         String   @default("VIGENTE") // VIGENTE | CONVOCATORIA_OBERTA | FINALIZADA
  url            String // enllaç a la font/convocatòria oficial
  source         String // nom de la font oficial (Ministeri, Gencat, BOE...)
  lastReviewedAt DateTime // darrera revisió editorial amb verificació de la font
  reviewedBy     String? // autor de la revisió (admin/system)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, scope, scopeCode])
}

// Catàleg de fonts oficials amb la seva traçabilitat (encàrrec: font,
// llicència, unitat, àmbit, periodicitat, metodologia). Citat per
// /api/provenance i pels informes PDF.
model DataSource {
  id           String            @id @default(cuid())
  code         String            @unique // INE_IPVA | INE_ATLAS_RENTA | SERPAVI | ...
  name         String // nom llegible de la font
  institution  String // INE | MIVAU | Incasòl | Gencat | ...
  url          String? // publicació oficial
  license      String? // condicions de reutilització
  unit         String? // unitat principal de les seves observacions
  periodicity  String? // ANUAL | TRIMESTRAL | EDITORIAL | ...
  methodology  String? // nota metodològica resumida
  notes        String?
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  observations StatObservation[]
}

// Una observació estadística = font + variable + territori + període + valor.
// municipalityCode és un enllaç LÒGIC amb Municipality.code (sense FK: la
// taula existent no es toca). Idempotència per clau única: reimportar una
// publicació actualitza els valors revisats per la font.
model StatObservation {
  id               String     @id @default(cuid())
  source           DataSource @relation(fields: [sourceId], references: [id])
  sourceId         String
  variable         String // IPVA_INDICE | IPVA_TASA_ANUAL | RENTA_NETA_MEDIA_PERSONA | RENTA_NETA_MEDIA_HOGAR
  geoLevel         String // ESTATAL | CCAA | PROV | MUNI
  geoCode          String // "ES" | "09" (CCAA) | "08" (prov) | ineCode de 5 dígits
  geoName          String? // nom oficial del territori segons la font
  municipalityCode String? // "080193" quan geoLevel=MUNI (enllaç lògic)
  period           String // "2024" (anual; admetrà "2026-T3" més endavant)
  value            Float
  unit             String?
  meta             String? // JSON {serie: "ADRH103925"} — traçabilitat de la sèrie INE
  runId            String? // ImportRun.id que va portar aquesta fila
  importedAt       DateTime   @default(now())

  @@unique([sourceId, variable, geoLevel, geoCode, period])
  @@index([variable, period])
  @@index([geoLevel, geoCode])
  @@index([municipalityCode])
  @@index([runId])
}
